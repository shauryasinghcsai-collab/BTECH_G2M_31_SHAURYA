#include <stdio.h>
int main()
{
    int n,i,max,min;
    printf("enter the size of array : ");
    scanf("%d",&n);
    int arr[n];
    printf("enter the elements ");
    for(i=0;i<n;i++)
    {
    scanf("%d",&arr[i]);
    }
    max=arr[0];
    min=arr[0];
    for (i=0;i<n;i++)
    {
        if(arr[i]<min)
        min=arr[i];
        if(arr[i]>max)
        max=arr[i];
    }
    printf("max:%d,min: %d \n", max,min);
    
    return 0;
}
    
